# Python
__pycache__/
*.pyc
.venv/
# docs/verifying-changes.md tells contributors to create this at the repo root,
# and `.venv/` does not match it.
.venv-test/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
*.tsbuildinfo

# Env — generic, so a root or per-package .env can never be committed by
# accident. The checked-in *.example templates are the exception.
.env
.env.*
!.env.example
!.env.*.example

# OS
.DS_Store

# Local scratch / experiments (never commit)
sandbox/

# Design-system tooling working dirs. Untracked today only because their
# contents happen to sit under node_modules/ or self-ignore; anything else
# dropped in them would otherwise be committed.
.ds-sync/
.design-sync/
ds-bundle/

# Per-developer Claude Code settings (settings.json IS shared).
.claude/settings.local.json

# scratch backup written by scripts/use_pivot.py
domain.config.json.bak
