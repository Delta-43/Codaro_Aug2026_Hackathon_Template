# Postgres connection string — lets the backend CREATE TABLES on startup.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# URL-encode special chars in the password. If unset, run supabase/schema.sql
# manually in the SQL editor.
#
# Direct connection (port 5432): note this host is IPv6-only. If your network has
# no IPv6 route you'll get "Network is unreachable" — use the Session pooler below.
# SUPABASE_DB_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
#
# Session pooler (IPv4, works everywhere). Note the username is postgres.<PROJECT-REF>
# and the host is region-specific — copy the exact string from the dashboard's
# "Session pooler" tab.
SUPABASE_DB_URL=postgresql://postgres:PZpqyUebn6SSQXEj@db.qeoizwuhdlsihxjftevs.supabase.co:5432/postgres

# Optional: point at a different pivot config
# DOMAIN_CONFIG_PATH=../domain.config.medical.example.json

# Auto-seed demo data on an empty database at startup (default on). Set to
# false to keep the db empty for real data after you've cleared the demo set.
# AUTO_SEED=false
