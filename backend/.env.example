SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional: direct Postgres connection string, used to auto-create tables
# (supabase/schema.sql) and for `python reseed.py`. Copy the *session pooler*
# string from Supabase → Connect (the direct db.<ref>.supabase.co host is
# IPv6-only and won't resolve from Docker):
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
