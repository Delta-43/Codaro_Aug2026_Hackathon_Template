SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Anon (public) key — used to build a per-request client that carries the
# user's JWT so Postgres Row Level Security applies to their reads/writes
# (Supabase → Settings → API → Project API keys → "anon public"). The service
# key above bypasses RLS and is kept for system/cross-user work.
SUPABASE_ANON_KEY=
# JWT secret used to verify the Supabase Auth access token on every request
# (Authorization: Bearer <jwt>). Supabase → Settings → API → JWT Settings →
# "JWT Secret". Required once auth is enabled; without it protected endpoints
# return 500 rather than accepting unverified requests.
SUPABASE_JWT_SECRET=
# Optional: direct Postgres connection string, used to auto-create tables
# (supabase/schema.sql) and for `python reseed.py`. Copy the *session pooler*
# string from Supabase → Connect (the direct db.<ref>.supabase.co host is
# IPv6-only and won't resolve from Docker):
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
# --- deployment (Railway) ---------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS. Leave as "*" for
# local dev; in prod set it to your Vercel URL(s), e.g.
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=*
# uvicorn worker count. Keep at 1: schema-setup + seeding run in the app
# lifespan, i.e. once per worker, so >1 risks a double-seed race. Raise only
# after moving seed/schema out of startup (see DEPLOY.md). Railway provides
# $PORT automatically — don't set it here.
WEB_CONCURRENCY=1
