SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Anon (public) key — used to build a per-request client that carries the
# user's JWT so Postgres Row Level Security applies to their reads/writes
# (Supabase → Settings → API → Project API keys → "anon public"). The service
# key above bypasses RLS and is kept for system/cross-user work.
SUPABASE_ANON_KEY=
# NOTE: there is no SUPABASE_JWT_SECRET. Access tokens are verified against the
# project's JWKS (public keys, fetched from SUPABASE_URL and cached), not a
# shared secret — so SUPABASE_URL is the auth-critical variable. If it is unset,
# protected endpoints return 500 rather than accepting unverified requests.
# Direct Postgres connection string. REQUIRED for automatic table creation:
# on startup the app runs supabase/schema.sql over this connection (idempotent).
# Without it, tables are NOT created and the app boots with an empty DB — you'd
# have to paste schema.sql into the Supabase SQL editor by hand. Also used by
# `python reseed.py`. Copy the *session pooler* string from Supabase → Connect
# (the direct db.<ref>.supabase.co host is IPv6-only and won't resolve from
# Docker/Railway):
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
# --- deployment (Railway) ---------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS. Leave as "*" for
# local dev; in prod set it to your Vercel URL(s), e.g.
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=*
# uvicorn worker count. Keep at 1: schema-setup + seeding run in the app
# lifespan, i.e. once per worker, so >1 risks a double-seed race. Raise only
# after moving seed/schema out of startup (see DEPLOY.md). Railway provides
# $PORT automatically — don't set it here.
WEB_CONCURRENCY=1
