# Backend base URL. Local dev points at the FastAPI container; in production
# (Vercel) set this to your deployed Railway backend URL, e.g.
# NEXT_PUBLIC_API_BASE=https://your-backend.up.railway.app
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Showcase-only build: serve the landing page, the config reference and the
# privacy page with no backend at all, and redirect every app route to `/`.
# Leave unset for a normal deployment. See DEPLOY.md.
# NEXT_PUBLIC_SHOWCASE_ONLY=1

# Supabase Auth (client-side email/password login). Find these in your Supabase
# project: Settings -> API -> Project URL and the "anon"/public key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
