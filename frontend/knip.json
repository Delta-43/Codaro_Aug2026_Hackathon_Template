{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,template,loading,error,not-found,route,default}.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "tw-animate-css",
    "tailwindcss"
  ],
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "src/api/config.generated.ts"
  ]
}
